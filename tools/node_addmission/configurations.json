          "sock_timeout":100,
          "credits":2560,
          "peer_credits":63,
          "enable_irq_affinity":0
        }
      },

      "grub":["crashkernel=1G-8G:256M,8G-:768M",
            "amd_iommu=off",
            "console=ttyS0,115200"
          ],
    
      "iommu":false,

      "kdump":{
          "sysconfig-kdump":[
            "nr_cpus=4",
            "rd.driver.blacklist=nvme"
