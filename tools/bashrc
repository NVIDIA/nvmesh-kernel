function nvcrash()
{
    local core="$1"
    local core_dir=`dirname $1`
    local src_dir="$2"
    local kver=`uname -r`
    local vmdbg="/usr/lib/debug/lib/modules/$kver/vmlinux"
    if [ -z "$src_dir" ]; then
        local src_dir=/home/jared/src/ssda
    fi
    local crashinit=`mktemp`
    local gdbinit=`mktemp`
    echo "gdb set disassembly-flavor intel" > $crashinit

# Load NVMesh Modules
    echo "mod -s nvmeibc ${src_dir}/clnt/nvmeibc.ko" >> $crashinit
    echo "mod -s nvmeibs ${src_dir}/srv/nvmeibs.ko" >> $crashinit
    echo "mod -s nvmeib_common ${src_dir}/common/nvmeib_common.ko" >> $crashinit
    echo "mod -s nvmeib_common_public ${src_dir}/common_public/nvmeib_common_public.ko" >> $crashinit
    echo "mod -s siw ${src_dir}/softiwarp/kernel/siw.ko" >> $crashinit

# Aliases
	echo "alias c_disk struct nvmeibc_disk" >> $crashinit
	echo "alias nrch struct nvmeibc_ib_nordda_channel" >> $crashinit
	echo "alias s_nrch struct nvmeibs_nr_channel" >> $crashinit
	echo "alias s_nrch_net struct nvmeibs_nr_channel.net" >> $crashinit
	echo "alias ri struct nvmeibc_volume_req_info" >> $crashinit
	echo "alias iu struct nvmeib_iu" >> $crashinit
	echo "alias clreq struct volume_client_req" >> $crashinit
	echo "alias c_net struct nvmeibc_ib_net" >> $crashinit
	echo "alias s_net struct nvmeibs_net" >> $crashinit
	echo "alias bcmd struct nvmeibc_disk_io_command" >> $crashinit
	echo "alias dcmd struct nvmeibc_disk_command" >> $crashinit
	echo "alias nr_wr_id p (union nordda_wr_id)(u64)" >> @crashinit
	echo "alias s_nr_cmd struct nvmeibs_nr_cmd" >> $crashinit
	echo "alias s_net_qp struct nvmeibs_net.qp" >> $crashinit

# Load Trace Extension
    if [[ -f /usr/lib64/crash/extensions/trace.so ]]; then
		echo "extend /usr/lib64/crash/extensions/trace.so" >> $crashinit
	fi

# Dump Trace Logs
	pushd $core_dir
	if [[ -f /usr/lib64/crash/extensions/crash_analyzer.so ]]; then
		sudo tar zxvf ${src_dir}/dictionaries.tar.gz
		sudo cp ${src_dir}/tools/traces_post_processor/pager.py .
		sudo cp ${src_dir}/tools/traces_post_processor/pager .
		echo "extend /usr/lib64/crash/extensions/crash_analyzer.so" >> $crashinit
		echo "tracedump all" >> $crashinit
	fi

# Source GDB init (be fns)
	echo "source ${src_dir}/tools/gdbinit" >> $crashinit

# Run Crash
    sudo crash $vmdbg $1 -i $crashinit

# Restore DIR
    popd
}

