DISKS_CSV_BLK_SZ_FIELD=3
DISKS_CSV_DEV_FIELD=7

# Clear Primary GPT Header for nvme device
# Parameters:
# $1 nvme device index 0 - 1000
function clrgpt()
{
    nvme_dev_idx=`expr 1000 + $1`
    nvme_dev=/dev/nvme${nvme_dev_idx}n1
    if [ ! -b $nvme_dev ]; then
        echo "Device $nvme_dev does not exist"
        exit -1
    fi
    disks_csv_line=`grep ${nvme_dev} /proc/nvmeibs/disks.csv`
    if [ -z $disks_csv_line ]; then
        echo "Device $nvme_dev not found in disks.csv"
        exit -1
    fi
    IFS="," read -r -a disk_csv_fields <<< $disks_csv_line
    num_lba_clr=100
    echo "Clearing GPT of Disk: ${disk_csv_fields[$DISKS_CSV_ID_FIELD]} Block Size: ${disk_csv_fields[$DISKS_CSV_BLK_SZ_FIELD]} Num Blocks: ${disk_csv_fields[$DISKS_CSV_BLOCKS_FIELD]}"
    echo 1 | sudo tee /proc/nvmeibs/freeze$1  > /dev/null
    echo "dd if=/dev/zero of=/dev/nvme${nvme_dev_idx}n1 bs=${disk_csv_fields[$DISKS_CSV_BLK_SZ_FIELD]} count=$num_lba_clr"
    sudo dd if=/dev/zero of=/dev/nvme${nvme_dev_idx}n1 bs=${disk_csv_fields[$DISKS_CSV_BLK_SZ_FIELD]} count=$num_lba_clr > /dev/null
    echo "dd if=/dev/zero of=/dev/nvme${nvme_dev_idx}n1 bs=${disk_csv_fields[$DISKS_CSV_BLK_SZ_FIELD]} seek=$((${disk_csv_fields[$DISKS_CSV_BLOCKS_FIELD]} - 100)) count=$num_lba_clr"
    sudo dd if=/dev/zero of=/dev/nvme${nvme_dev_idx}n1 bs=${disk_csv_fields[$DISKS_CSV_BLK_SZ_FIELD]} seek=$((${disk_csv_fields[$DISKS_CSV_BLOCKS_FIELD]} - 100)) count=$num_lba_clr > /dev/null
    echo 0 | sudo tee /proc/nvmeibs/freeze$1 > /dev/null
}

# Clear Primary GPT Header for all nvme devices
function clrgptall()
{
    for i in `seq 0 999`; do
        nvme_idx=`expr 1000 + $i`
        if [ -e /dev/nvme${nvme_idx}n1 ]; then
            clrgpt $i
        fi
    done
}

# Send command for volume to nvmeibc cli
# Parameters:
# $1 - volume name
# $2 - command
# $3 - command parameters
function volcmd()
{
    vol=$1
    cmd=$2
    params=$3
    echo \#${vol}\|${cmd}=${params} | sudo tee /proc/nvmeibc/cli/cli
}

# Launch volume recovery using nvmeibc cli
# Parameters:
# $1 - volume name
# $2 - chunk
# $3 - raid
# $4 - segment
# $5 - recovery type (dirty, stale or cold)
function rcvlaunch()
{
    vol=$1
    chunk=$2
    raid=$3
    seg=$4
    case "$5" in
        dirty)
            type="1"
            ;;
        stale)
            type="2"
            ;;
        cold)
            type="3"
            ;;
        jgc)
            type="6"
            ;;
    esac
    volcmd $vol recov_launch $chunk,$raid,$seg,$type
}

# Set volume max_retry_secs
# Parameters:
# $1 - volume name
# $2 - max_retry_secs
function maxretry()
{
    vol=$1
    secs=$2
    volcmd $vol max_retry_secs $secs
}

