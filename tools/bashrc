# Run sudo ethtool on base device - Good for Azure
# ethtool param format is nearly always ethtool mode dev mode_params
# So we need to translate the 2nd param to the base device
# Except when there is only 1 param which is the device

function ethtoolb()
{
	if [ $# -eq 1 ]; then
		local DEVICE="$1"
	else
		local MODE="$1"
		shift
		local DEVICE="$1"
		shift
		local MODE_PARAMS="$@"
	fi

	# Follow "lower" links down to base device (e.g. /sys/class/net/eth0/lower_enPxxx)
	BASE_DEVICE=$DEVICE
	LOWER_LINK=$(find /sys/class/net/$BASE_DEVICE/ -name 'lower_*' -type l)
	while [ ! -z $LOWER_LINK ]; do
		BASE_DEVICE=$(basename $LOWER_LINK | cut -c 7-)
		LOWER_LINK=$(find /sys/class/net/$BASE_DEVICE/ -name 'lower_*' -type l)
	done

	sudo ethtool $MODE $BASE_DEVICE $MODE_PARAMS
}

# nvmesh ethtool dump - dump all relevant info of nvmesh device N
function nvethdump()
{
	if [ $# -eq 0 ]; then
		# Get device from nvmesh.conf
		source /etc/nvmesh/nvmesh.conf
		DEVICE=$(echo $CONFIGURED_NICS | cut -d' ' -f1)
	else
		DEVICE="$1"
	fi

	echo "Ethtool Dump of $DEVICE"
	echo "--------------SUMMARY-------------------------------------"
	# Summary of Device
	ethtoolb $DEVICE
	echo "--------------FEATURES-------------------------------------"
	# Check state of device features
	ethtoolb -k $DEVICE
	echo "--------------N-TUPLE RULE---------------------------------"
	# Show all rules
	ethtoolb -n $DEVICE
	echo "--------------RSS HASH-------------------------------------"
	# retrieve the hash options for TCP flow type.
	ethtoolb -n $DEVICE rx-flow-hash tcp4
	echo "--------------CHANNELS-------------------------------------"
	# show device channels
	ethtoolb -l $DEVICE
	echo "--------------RSS INDIRECTION------------------------------"
	# show Rx flow hash indirection table and/or RSS hash key
	ethtoolb -x $DEVICE
	echo "--------------RX STATISTICS--------------------------------"
	# show rx packet stats
	ethtoolb -S $DEVICE | grep rx | grep packet
	echo "--------------TX STATISTICS--------------------------------"
	ethtoolb -S $DEVICE | grep tx | grep packet
}

