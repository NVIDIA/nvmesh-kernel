# Print all gids of all devices in a table
function __allgids()
{
    echo "Device,Port,GID Num,GID,Net Device,Type"
    for i in $(grep -vl -e 0000:0000:0000:0000:0000:0000:0000:0000 -e fe80:0000:0000:0000:0000:0000:0000:0000 /sys/class/infiniband/*/ports/*/gids/* 2> /dev/null)
    do
        dev=$(echo $i | cut -d'/' -f5)
        port=$(echo $i | cut -d'/' -f7)
        gid_num=$(echo $i | cut -d'/' -f9)
        gid=$(cat $i)
        ndev=$(cat $(echo $i | sed 's/gids/gid_attrs\/ndevs/') 2> /dev/null)
        type=$(cat $(echo $i | sed 's/gids/gid_attrs\/types/') 2> /dev/null)
        echo -e "$dev,$port,$gid_num,$gid,$ndev,$type"
    done
}

function allgids()
{
    __allgids | column -t -s,
}

