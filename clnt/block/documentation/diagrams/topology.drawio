        <mxCell id="0nDvLLGVFHGVUphMvvgY-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;W+&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RAID has 2 topologies - data &amp;amp; locks;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;W+ is a topology, when a segment has valid data, but cannot hold locks (owner or copy)&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;After a segment rebuilt, it&#39;s access mode may become &quot;W+&quot; for a short period of time&lt;/li&gt;&lt;li&gt;Before a segment replacement, the segment access mode may become &quot;W+&quot;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="80" y="200" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="0nDvLLGVFHGVUphMvvgY-5" value="* for all practical needs, the client may assume that W+&amp;nbsp; and RW are same access modes" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="80" y="920" width="480" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="RAID access mode" id="3uCdUdoEgCKpzGHfFNRt">
    <mxGraphModel dx="2037" dy="825" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="FhBAvovJc58IdH6_6Gne-0" />
        <mxCell id="FhBAvovJc58IdH6_6Gne-1" parent="FhBAvovJc58IdH6_6Gne-0" />
        <mxCell id="FhBAvovJc58IdH6_6Gne-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;RAID access mode&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Degraded segment is a segment, whose access mode is != RW&lt;/li&gt;&lt;li&gt;Protection level - data redundancy - IOable RAID has maximum &quot;protection level&quot; degraded segments&lt;/li&gt;&lt;li&gt;RAID rebuild&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;on the whole RAID - a single segment could not be rebuilt&lt;/li&gt;&lt;ul&gt;&lt;li&gt;it means that topology (W,W) will not become (RW,W) or (W, RW) always (RW,RW) or (D, RW)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;RW segments are used as the sources and as a &quot;natural&quot; sharding to speed-up the process&lt;/li&gt;&lt;li&gt;RAID topology is &quot;frozen&quot; during rebuild - it will start and end with the same topology&lt;/li&gt;&lt;li&gt;Any topology change aborts the rebuild process&lt;/li&gt;&lt;li&gt;If some segment is back to live during rebuild process, it&#39;s access mode will stay dead, while rebuild is running&lt;/li&gt;&lt;li&gt;If during rebuild, the client reconnects and nothing changed on the servers - it will continue the rebuild process using the same topology&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="FhBAvovJc58IdH6_6Gne-1" vertex="1">
          <mxGeometry x="40" y="40" width="750" height="260" as="geometry" />
        </mxCell>
        <mxCell id="N1MG3H__Wj5tJ4aXHGD1-1" value="" style="group" vertex="1" connectable="0" parent="FhBAvovJc58IdH6_6Gne-1">
