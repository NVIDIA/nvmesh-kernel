        </mxCell>
        <mxCell id="mRtqyXpgbR3qekdRVjHb-37" value="&quot;open&quot; cannot be executed - the bdev name is removed from the FS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=8;" vertex="1" parent="mRtqyXpgbR3qekdRVjHb-38">
