#!/bin/bash
cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1

if declare -F NVMESH_help > /dev/null; then
	echo "help scripts already exist";
else
	source ../../tools/block_team_bashrc.sh;	# Load the bashrc
fi
EXE_NAME="nvmeibt_toma";
function __run_cmd() {	cmd=("$@"); echo -e "\e[1;33m************************ ${cmd}\e[0;39m"; eval ${cmd}; }
function _print_wait() { cmd=("$@"); echo -en "\e[1;33m************************ ${cmd}\e[0;39m"; read -p ", Press Enter..." -r; echo; }

function __cleanup_prev_run_state() {
	make clean_run;
	kill_process;
}

function kill_process() {
	pgrep "${EXE_NAME}" > /dev/null || return 0;
	echo "process is already running - terminating it; PID: $(pgrep "${EXE_NAME}")"
	# First try to send SIGTERM to the process as regular user - avoid sudo unless necessary.
	if ! pkill "${EXE_NAME}"; then
		echo "unable to send SIGTERM to ${EXE_NAME} as regular user, trying with sudo";
		sudo pkill ${EXE_NAME} || { echo_red "failed to sudo pkill"; exit 1; }
	else
		# Sent SIGTERM successfully as user
		echo "previously running process was terminated"
	fi
}

function __force_rebuild() {
	echo "Rebuilding project...";
	make clean;
	local compile_cmd="make all -j $@";
	__run_cmd "$compile_cmd" || { echo_red "Build failed"; exit 1; }
}

function __build_if_needed() {
	__cleanup_prev_run_state;
	if [[ ! -f "${EXE_NAME}" ]]; then
		__force_rebuild || exit $?;
	fi
	local compile_cmd="make all -j $@";
	__run_cmd "$compile_cmd" || { echo_red "Build failed"; exit 1; }
}

function __abort_ci_on_failure_silent() {
	[ $? -eq 0 ] || { echo_red "FAILED - status=$?" && exit 4; }
}

function __abort_ci_on_failure() {
	[ $? -eq 0 ] && echo_green "SUCCESS!\n\n" || { echo_red "FAILED - status=$?" && exit 1; }
}

function T_SANDBOX_gpt_util_self_unit_test() {
	__build_if_needed;
	local disks_csv_file="_root/proc/nvmeibs/disks.csv";
	echo_title "Creating ${disks_csv_file}";
	echo -e "id,blocks,hw_blocks,block_size,max_request_size,seq,nsid,dev_name,metadata,status,vendor,model,native_serial\nNVMD_f37_002.1,32768,32768,4096,32,1,1,/dev/nvme1001n1,0,Ok,5122,NVMD_NN_002,NVMD_f37_002\nNVMD_f37_003.1,32768,32768,4096,32,2,1,/dev/nvme1002n1,8,Ok,5123,NVMD_NN_003,NVMD_f37_003" > ${disks_csv_file};
	./${EXE_NAME} gpt_util -T ${@};
	local test_rv=$?;
	rm -f ${disks_csv_file} _root/tmp/gpt_seg_metadata_test;
	[ ${test_rv} -eq 0 ] && echo_green "SUCCESS!\n\n" || { echo_red "FAILED - status=$?" && exit 1; }
}

function T_SANDBOX_toma_persist_json_test() {
	echo_title "Generating Toma persistency JSON";
	local persist="_root/var/opt/nvmesh/toma/toma_persistence_2_8_0_raft_and_topo.0";
	local bin_orig="z.bin";
	local orig_json="z.json";
	#./${EXE_NAME} --convert-to-json --input-file ${persist} --output-file ${orig_json};
	cp ${persist} ${bin_orig};
	../scripts/toma_persistence_to_JSON.sh <<< "$(printf '%s\n%s\n%s\n' "${bin_orig}" "${orig_json}" "./${EXE_NAME}")";
	__abort_ci_on_failure_silent;

	echo_title "Encoding Toma Persistency j2bin";
	local bin_1="${orig_json}.bin";
	../scripts/JSON_to_toma_persistence.sh <<< "$(printf '%s\n%s\n%s\n' "${orig_json}" "${bin_1}" "./${EXE_NAME}")";
	__abort_ci_on_failure_silent;

	echo_title "Toma persistency j2bin2j";
	local json_1="${bin_1}.json";
	../scripts/toma_persistence_to_JSON.sh <<< "$(printf '%s\n%s\n%s\n' "${bin_1}" "${json_1}" "./${EXE_NAME}")";
	__abort_ci_on_failure_silent;

	echo_title "Encoding Toma Persistency j2bin2j2bin";
	local bin_2="${json_1}.bin";
	../scripts/JSON_to_toma_persistence.sh <<< "$(printf '%s\n%s\n%s\n' "${json_1}" "${bin_2}" "./${EXE_NAME}")";
	__abort_ci_on_failure_silent;

	echo_title "Toma persistency j2bin2j2bin2j";
	local json_2="${bin_2}.json";
	../scripts/toma_persistence_to_JSON.sh <<< "$(printf '%s\n%s\n%s\n' "${bin_2}" "${json_2}" "./${EXE_NAME}")";
	__abort_ci_on_failure_silent;

	echo_title "Toma persistency Results";
	ls -l z.*;
	cmp -s ${json_1} ${json_2} || { echo_red "FAILED - json not identical" && exit 4; }
	cmp -s ${bin_1}  ${bin_2}  || { echo_red "FAILED - bins not identical" && exit 4; }
	__run_cmd "cat ${orig_json} | jq .";
	__run_cmd "cat ${json_2} | jq .";
	sudo rm ${bin_orig}* ${orig_json}*;
	__abort_ci_on_failure;
}

function T_SANDBOX_test_framework() {
	__build_if_needed;
	./${EXE_NAME} test_framework ${@};
	__abort_ci_on_failure;
}

function T_SANDBOX_wire_buf_test() {
	__build_if_needed;
	./${EXE_NAME} wire_buf_test ${@};
	__abort_ci_on_failure;
}

function T_SANDBOX_trace_compress_test() {
	__build_if_needed;
	./${EXE_NAME} trace_compress_test ${@};
	__abort_ci_on_failure;
}

PAGER="_root/var/log/nvmesh/trace_daemon/pager";
TRACE_DIR="_root/var/log/nvmesh/trace_daemon";
function T_SANDBOX_trace_compress_comparison() {
	__build_if_needed;
	mkdir -p out;

	local tmpdir;
	tmpdir=$(mktemp -d);

	# --- Run 1: plain (default, compression off) ---
	echo_title "Trace compress comparison: plain run";
	__cleanup_prev_run_state;
	./${EXE_NAME};
	__abort_ci_on_failure;

	local plain_size=$(du -cb ${TRACE_DIR}/toma*.binlog* 2>/dev/null | tail -1 | cut -f1);
	local plain_n_files=$(ls ${TRACE_DIR}/toma*.binlog* 2>/dev/null | wc -l);

	# Try decoding with pager (best-effort — may fail on read-only filesystems)
	local pager_ok=0;
	if ${PAGER} ${TRACE_DIR} --toma > ${tmpdir}/plain_pager.txt 2>/dev/null; then
		pager_ok=1;
	fi

	# --- Run 2: compressed (use -Z startup flag so compression is active from first file) ---
	echo_title "Trace compress comparison: compressed run";
	__cleanup_prev_run_state;
	./${EXE_NAME} -Z;
	__abort_ci_on_failure;

	local compressed_size=$(du -cb ${TRACE_DIR}/toma*.binlog* 2>/dev/null | tail -1 | cut -f1);
	local compressed_n_files=$(ls ${TRACE_DIR}/toma*.binlog* 2>/dev/null | wc -l);
	local lz4_count=$(ls ${TRACE_DIR}/toma*.lz4 2>/dev/null | wc -l);

	# Try decoding compressed logs
	if [ ${pager_ok} -eq 1 ]; then
		${PAGER} ${TRACE_DIR} --toma > ${tmpdir}/compressed_pager.txt 2>/dev/null || pager_ok=0;
	fi

	# --- Report ---
	echo "-----------------------------------------------";
	echo "  Plain:      ${plain_n_files} files, ${plain_size} bytes";
	echo "  Compressed: ${compressed_n_files} files, ${compressed_size} bytes (${lz4_count} .lz4)";

	# --- Assertions ---
	if [ "${lz4_count}" -eq 0 ]; then
		echo_red "FAILED: no .lz4 files found";
		exit 1;
	fi

	if [ "${compressed_size}" -ge "${plain_size}" ]; then
		echo_red "FAILED: compressed size (${compressed_size}) >= plain size (${plain_size})";
		exit 1;
	fi

	local ratio=$(echo "scale=1; ${plain_size} / ${compressed_size}" | bc);
	echo "  Ratio:      ${ratio}x";

	if [ ${pager_ok} -eq 1 ]; then
		local plain_lines=$(wc -l < ${tmpdir}/plain_pager.txt);
		local compressed_lines=$(wc -l < ${tmpdir}/compressed_pager.txt);
		echo "  Plain pager lines:      ${plain_lines}";
		echo "  Compressed pager lines: ${compressed_lines}";
		# Both runs execute the same tests so line counts should be similar.
		# Allow 20% tolerance for timing differences.
		local min_lines=$(echo "${plain_lines} * 80 / 100" | bc);
		if [ "${compressed_lines}" -lt "${min_lines}" ]; then
			echo_red "FAILED: compressed pager output too short (${compressed_lines} < ${min_lines})";
			exit 1;
		fi
		echo_green "  Pager decoded both plain and compressed logs successfully";
	else
		echo_yellow "  Pager unavailable — skipping decoded content comparison";
	fi

	rm -rf ${tmpdir};
	echo_green "SUCCESS!";
}

#/******************************* Code Coverage *******************************/
COVERAGE_DIR="./build/coverage";
function __lcov_ignore_errors() {
	# lcov 1.x supports: gcov,source,graph
	# lcov 2.x adds: mismatch,negative,empty,unused,unmapped,format
	# Use version-appropriate flags for forward/backward compatibility
	local lcov_major;
	lcov_major=$(lcov --version 2>&1 | grep -oP 'version \K[0-9]+');
	if [ "${lcov_major:-1}" -ge 2 ]; then
		echo "gcov,source,graph,mismatch,negative,empty";
	else
		echo "gcov,source,graph";
	fi
}
function __genhtml_ignore_errors() {
	local lcov_major;
	lcov_major=$(lcov --version 2>&1 | grep -oP 'version \K[0-9]+');
	if [ "${lcov_major:-1}" -ge 2 ]; then
		echo "unmapped,source";
	else
		echo "source";
	fi
}
function T_SANDBOX_coverage() {
	if ! command -v lcov &>/dev/null || ! command -v genhtml &>/dev/null; then
		echo_red "Error: lcov and genhtml are required. Install via: sudo apt install lcov (or dnf install lcov)";
		# sudo apt install wslu;		# Optionally: View html in WSL
		exit 1;
	fi
	local lcov_errs; lcov_errs=$(__lcov_ignore_errors);
	local genhtml_errs; genhtml_errs=$(__genhtml_ignore_errors);
	local branch_rc="lcov_branch_coverage=1";

	echo_title "Coverage: clean build with instrumentation";
	__force_rebuild USE_GCOV=1;

	echo_title "Coverage: running CI test suite";
	__run_ci_suite || true;		# Don't abort coverage on test failure

	echo_title "Coverage: generating report: ${COVERAGE_DIR}";
	mkdir -p ${COVERAGE_DIR};

	# Capture raw coverage from entire build tree (production .gcno files are in 99bin/debug/, test ones in 99bin/debug/obj/)
	local flags="--rc ${branch_rc} --ignore-errors ${lcov_errs} --quiet";
	local cmd="lcov --capture --directory 99bin --output-file ${COVERAGE_DIR}/coverage_raw.lcov ${flags}";	__run_cmd "${cmd}";

	# Filter: keep only toma/ production code (exclude unitest, autogen, tools, common, etc.)
	cmd="lcov --extract ${COVERAGE_DIR}/coverage_raw.lcov '*/toma/*.c' '*/toma/*.h'               --output-file ${COVERAGE_DIR}/coverage_toma.lcov ${flags}"; __run_cmd "${cmd}";
	cmd="lcov --remove ${COVERAGE_DIR}/coverage_toma.lcov '*/unitest/*' '*/autogen/*' '*/99bin/*' --output-file ${COVERAGE_DIR}/coverage.lcov      ${flags}"; __run_cmd "${cmd}";
	rm -f ${COVERAGE_DIR}/coverage_raw.lcov ${COVERAGE_DIR}/coverage_toma.lcov;

	# Generate HTML report
	cmd="genhtml ${COVERAGE_DIR}/coverage.lcov --output-directory ${COVERAGE_DIR}/html --rc ${branch_rc} --ignore-errors ${genhtml_errs} --quiet";  __run_cmd "${cmd}";

	# Copy lcov.info for IDE integration (Coverage Gutters etc.)
	cp ${COVERAGE_DIR}/coverage.lcov lcov.info;

	# Print summary
	echo "-----------------------------------------------";
	lcov --summary ${COVERAGE_DIR}/coverage.lcov --rc ${branch_rc} 2>&1 | grep -E "lines|functions|branches";
	echo "-----------------------------------------------";
	local report_html="${COVERAGE_DIR}/html/index.html";
	echo_green "HTML report: ${report_html}";			#wslview ${report_html}
	echo_green "IDE lcov:    lcov.info";

	if false; then   # Install vscode extension. Install 'Coverage Gutters'. If running in Windows WSL install it in wsl, not in windows.
		#Daniel added the following lines to: C:/Users/danielhe/AppData/Roaming/Code/User/settings.json
			"coverage-gutters.coverageBaseDir": "toma/unitest/",
			"coverage-gutters.lcovname": "toma/unitest/lcov.info",
			"coverage-gutters.showGutterCoverage": true,
			"coverage-gutters.showLineCoverage": true
		# View 'lcov.info' report in VSCode/Cursor: Press Ctrl+Shift+P, then type: "Coverage Gutters: Watch". Now it will mark covered lines with GREEN color to stop viewing type "Coverage Gutters: Clear Coverage"
	fi;
	if false; then   # Cleanup
		rm -rf ${COVERAGE_DIR} lcov.info;
	fi;
}
#/******************************* Code Coverage *******************************/

TOMA_TXT_LOGS="z.txt";
TOMA_RPC_CONFIG="_root/opt/nvmesh/common-repo/tools/toma_rpc.config";
function T_SANDBOX_main_self_unit_test() {
	__cleanup_prev_run_state;
	__build_if_needed;
	./${EXE_NAME};
	__abort_ci_on_failure;
	_root/var/log/nvmesh/trace_daemon/pager _root/var/log/nvmesh/trace_daemon --toma --color  > ${TOMA_TXT_LOGS};
}

function T_SANDBOX_incremental_topo_main() {
	echo "+ param is_incremental_wire_buf 1" >> ${TOMA_RPC_CONFIG};
	T_SANDBOX_main_self_unit_test;
	grep -v 'is_incremental_wire_buf' ${TOMA_RPC_CONFIG} > ${TOMA_RPC_CONFIG}.tmp && mv ${TOMA_RPC_CONFIG}.tmp ${TOMA_RPC_CONFIG};
}

function T_SANDBOX_main_self_reuse_persistency_unit_test() {
	./${EXE_NAME};
	__abort_ci_on_failure;
}

function T_SANDBOX_main_live_run() {
	echo_red "Todo: Test, Not supported yet";
}

# CI test suite — used by both 'ci' and 'coverage' commands.
function __run_ci_suite() {
	T_SANDBOX_main_self_unit_test;
	T_SANDBOX_main_self_reuse_persistency_unit_test;
	rm -f ${TOMA_TXT_LOGS};			# Not needed, if run succeeded, CI does not have to save the logs.
	T_SANDBOX_incremental_topo_main;
	T_SANDBOX_main_self_reuse_persistency_unit_test;	# Reuse incremental-era persistence with incremental off — cross-version compat
	rm -f ${TOMA_TXT_LOGS};			# Not needed, if run succeeded, CI does not have to save the logs.
	T_SANDBOX_toma_persist_json_test;
	T_SANDBOX_gpt_util_self_unit_test;
	T_SANDBOX_test_framework;
	T_SANDBOX_wire_buf_test;
	T_SANDBOX_trace_compress_test;
	T_SANDBOX_trace_compress_comparison;
}

# ---------------------------------------------------------------------
case "$1" in
  rebuild*)		__force_rebuild;;
  framework*)	T_SANDBOX_test_framework ${@:2};;
  wire*)		T_SANDBOX_wire_buf_test ${@:2};;
  trace_comp*)	T_SANDBOX_trace_compress_test ${@:2};;
  trace_cmp*)	T_SANDBOX_trace_compress_comparison ${@:2};;
  main*)		T_SANDBOX_main_self_unit_test ${@:2};;
  incr*)		T_SANDBOX_incremental_topo_main ${@:2};;
  live*)		T_SANDBOX_main_live_run;;
  gpt*)			T_SANDBOX_gpt_util_self_unit_test ${@:2};;
  persi*)		T_SANDBOX_toma_persist_json_test;;
  cover*)		T_SANDBOX_coverage;;
  gen_logs*)	_root/var/log/nvmesh/trace_daemon/pager _root/var/log/nvmesh/trace_daemon --toma --color  > ${TOMA_TXT_LOGS};;
  ci*)
	clear;
	#__force_rebuild BUILD_RELEASE=1;
	__run_ci_suite;
	date;
	echo_green "************************ CI Done";
	;;
  *)
	echo $"Usage: $0 {1 of the options below}";
	echo_yellow "  ------------ Unit-tests of sub components:";
	echo "    main              - Self test of toma main executable";
	echo "    incremental_topo  - Main test with incremental wire buf enabled";
	echo "    gpt_util          - Self test of gpt utility";
	echo "    persistency       - Self test of Toma persistency utility";
	echo "    framework         - Test framework smoke test";
	echo "    wire_buf          - Wire buffer unit tests";
	echo "    trace_compress    - Trace LZ4 compression unit tests";
	echo "    trace_cmp         - Compare plain vs compressed binlog size and pager output";
	echo_yellow "  ------------ Debug, development tests:";
	echo "    rebuild           - Fully recompile Toma. Pass additional make params like release compilation"
	echo "    live              - Launch Toma to be able to manually play with it, RPC and others";
	echo "    coverage          - Build with gcov, run tests, generate HTML + lcov.info coverage report";
	echo "    ci                - Nightly/CI run";
	echo "    gen_logs          - Convert binary traces to ${TOMA_TXT_LOGS} file";
	exit 2
esac
RETVAL=$?
echo
exit $RETVAL
