oldNVMesh=/etc/NVMesh
oldPath=$oldNVMesh/block_devices_configuration
newPath=/var/opt/NVMesh/block_devices_configuration

cp $oldPath/* $newPath/

#We must delete this path manually as it won't be removed upon upgrade.
rm -fr $oldNVMesh
