#!/usr/bin/env python3

import argparse
import json
import subprocess
import os
import yaml
from threading import Thread
import sys
import pprint

from scale_sim_controller import ScaleSimControllerParser, ClientController, TargetController, NodeController, UpgradeAgentController, CONFIG_DIR

from os.path import expanduser
USER_HOME_DIR = expanduser("~")


def log(msg, end='\n', flush=False):
	sys.stdout.write(msg + end)
	if flush:
		sys.stdout.flush()


def buildParser():
	parser = argparse.ArgumentParser(description='NVMesh Scale Simulator Manager')
	subparsers = parser.add_subparsers(dest="command")
	addRunParser(subparsers)
	addStopParser(subparsers)
	addDeployParser(subparsers)
	addInstallParser(subparsers)
	addLogsParser(subparsers)
	addClearCacheParser(subparsers)
	return parser, subparsers


def addRunParser(subparsers):
	subParser = subparsers.add_parser('run', help='Run The Simulator')
	subParser.add_argument('-i', '--image', type=str, default='excelero/scale-sim', help='The Docker image ID to spawn the containers from')
	subParser.add_argument('-n', type=int, help='Number of simulated machines')
	subParser.add_argument('-s','--hosts', type=str, nargs='+', default=['localhost'], help='A list of actual servers of which to spawn the Docker containers')
	subParser.add_argument('-c','--config', type=str, default=USER_HOME_DIR + '/.scale-sim/config.yaml', help='The path to the config file')
	subParser.add_argument('--cluster-deployment-config', type=str, help='The path to the cluster-deployment-config.json file')
	subParser.add_argument('--debug', action='store_true', default=False)
	subParser.add_argument('--logs', action='store_true', default=False)
	subParser.add_argument('--mongo-uri', type=str, help='The mongoDB URI to load the nodes configuration from')
	subParser.add_argument('--port', action='append', type=str, help='port mapping in the format "5678:5678"')


def addStopParser(subparsers):
	subParser = subparsers.add_parser('stop', help='Stop The Simulator')
	subParser.add_argument('-s','--hosts', type=str, nargs='+', default=['localhost'], help='A list of host servers on which to stop the containers')
	subParser.add_argument('-c','--containers', type=str, nargs='+', default=["all"],
						help='A list of containers to stop, "all" will stop all containers on the host. either index or full container hostname are accepted')


def addDeployParser(subparsers):
	subParser = subparsers.add_parser('deploy', help='Deploy the Simulator on hosts')
	subParser.add_argument('-i', '--image', type=str, default='excelero/scale-sim', help='The Docker image to copy')
	subParser.add_argument('-s','--hosts', type=str, nargs='+', default=['localhost'], help='A list of Actual servers to which to copy the image')


def addInstallParser(subparsers):
	subParser = subparsers.add_parser('install', help='Install the Simulator on hosts')
	subParser.add_argument('-s','--hosts', type=str, nargs='+', default=['localhost'], help='A list of Actual servers on which to install the Simulator')
	subParser.add_argument('--build', action='store_true', default=False)
	subParser.add_argument('--deploy', action='store_true', default=False)
	subParser.add_argument('-i', '--image', type=str, default='excelero/scale-sim', help='The Docker image to copy')


def addLogsParser(subparsers):
	subParser = subparsers.add_parser('logs', help='Show logs')
	subParser.add_argument('-s','--host', type=str, default=['localhost'], help='The host name on which the container is running')
	subParser.add_argument('-c','--container', type=str, required=True, help='The name of the container to see logs from')
	subParser.add_argument('-f','--follow', action='store_true', default=False, help='follow logs')


def addClearCacheParser(subparsers):
	subParser = subparsers.add_parser('clear', help='clear / or delete elements')
	clearParsers = subParser.add_subparsers(dest="clearWhat")
	clearCacheParser = clearParsers.add_parser('cache', help='clear cache')
	clearCacheParser.add_argument('-s','--hosts', type=str, nargs='+', default=['localhost'], help='The host name on which the container is running')


def doParallel(iterable, func, *args):
	threads = []

	for item in iterable:
		argsWithItem = (item,) + args
		t = Thread(target=func, args=argsWithItem)
		t.start()
		threads.append(t)

	for t in threads:
		t.join()


def checkConfigFileIsValid(configFilepath):
	isFileExists(configFilepath)
	config = readConfigFromFile(configFilepath)

	if 'managementServers' not in config['baseConfig']:
		log("WARNING: 'managementServers' not found in config, containers will use management address 'localhost:4001'")


def isFileExists(filepath):
	if not os.path.isfile(filepath):
		log("Error: Config file not found {}".format(filepath))
		exit(2)


def readConfigFromFile(filepath):
	with open(filepath) as f:
		try:
			if filepath.endswith('.yaml'):
				config = yaml.safe_load(f)
			else:
				config = json.load(f)
			return config
		except Exception as ex:
			log("Error: could not parse JSON from Config file at: {0}, exception: {1}".format(filepath, ex))
			exit(2)


def run(args):
	hostsParams = None
	containersNumber = None
	hostsNumber= None

	checkConfigFileIsValid(args.config)
	if args.n:
		hostsParams = getListOfHostParameters(args)
		containersNumber = args.n
		hostsNumber = len(args.hosts)
	elif args.cluster_deployment_config:
		hostsParams = getListOfHostParametersFromClusterDeploymentConfigFile(args)
		containersNumber = reduce(lambda acc, hostParams: acc + hostParams[2] - hostParams[1] + 1, hostsParams, 0)
		hostsNumber = len(hostsParams)
	else:
		log("You have to specify a number of simulated machines with -n, or a cluster deployment config file with --cluster-deployment-config")
		exit(2)

	showDebug = args.debug
	quiet = '--debug' if showDebug else ''
	ports = ''
	if args.port:
		for p in args.port:
			ports += ' --port ' + p + ' '

	def runOnSingleHost(argsTuple):
		host, start, end, image, config = argsTuple

		# create the node-config file on the local machine
		NODE_CONFIG_DIR = expanduser('~/.scale-sim/')
		NODE_CONFIG_FILE_NAME = '.node-config.json'
		NODE_CONFIG_FILE_PATH = NODE_CONFIG_DIR + NODE_CONFIG_FILE_NAME

		config = readConfigFromFile(args.config)
		runCommand('mkdir -p %s' % NODE_CONFIG_DIR, debug=True)

		with open(NODE_CONFIG_FILE_PATH, 'w') as fp:
			json.dump(config, fp)

		# copy config to machine
		if host != 'localhost':
			destHost = "{}:".format(host)
			mkdirOnRemote = "ssh {} mkdir -p .scale-sim".format(host)
			runCommand(mkdirOnRemote, debug=True)
			rsyncCmd = "rsync {config_file} --rsync-path=\"mkdir -p .scale-sim && rsync\" {destHost}.scale-sim/.node-config.json".format(config_file=NODE_CONFIG_FILE_PATH, destHost=destHost)
			runCommand(rsyncCmd, debug=True)

		mongoURIFlag = '--mongo-uri {}'.format(args.mongo_uri) if args.mongo_uri else ''
		logs_flag = '--logs' if args.logs else ''
		cmd = "/opt/scaleSim/scale-sim-runner.py --image {image} --n_start {startInx} --n_end {endIdx} {quiet} {logs} {mongo} {ports}".format(
			image=image, startInx=start, endIdx=end, quiet=quiet, logs=logs_flag, mongo=mongoURIFlag, ports=ports)

		runCommandOnHost(cmd, host, showDebug)

	doParallel(hostsParams, runOnSingleHost)
	log("finished spawning {} containers on {} hosts".format(containersNumber, hostsNumber))


def getListOfHostParameters(args):
	numOfContainers = args.n
	numOfHosts = len(args.hosts)
	containersPerHost = round(numOfContainers / numOfHosts)
	hostsParams = []

	# calculate start and end for each host
	containersSpawned = 0
	for index, host in enumerate(args.hosts):
		start = containersSpawned + 1
		end = int(containersSpawned + containersPerHost)
		if index + 1 <= numOfContainers % numOfHosts:
			end += 1

		end = min(end, numOfContainers)
		containersSpawned = end
		argsTuple = (host, start, end, args.image, args.config)
		hostsParams.append(argsTuple)
		if end >= numOfContainers:
			break

	return hostsParams


def getListOfHostParametersFromClusterDeploymentConfigFile(args):
	isFileExists(args.cluster_deployment_config)
	config = readConfigFromFile(args.cluster_deployment_config)
	hostsParams = []

	for hostInfo in config:
		host = hostInfo['host']

		if isinstance(hostInfo['containers'], list):
			if len(hostInfo['containers']) != 2:
