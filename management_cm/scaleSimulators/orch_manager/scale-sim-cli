def stop(args):
	def stopAllContainersOnHost(host):
		cmd = "sudo /opt/scaleSim/docker_stop.sh {}".format(' '.join(args.containers))
		log("Stopping all instances on {}".format(host))
		runCommandOnHost(cmd, host)

	doParallel(args.hosts, stopAllContainersOnHost)
	log("All instances Stopped on {}".format(args.hosts))


def getLatestImage():
	cmd = "docker image ls --format \"{{.ID}}\" | head -1"
	p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
	out, err = p.communicate()
	imageID = out.split('\n')[0]

	print("using latest image with id {}".format(imageID))
	return imageID


def deploy(args):

	# create tar from docker image
	log("packing docker image {} into a .tar archive".format(args.image))

	tarFileName = 'docker-image-{}.tar'.format(args.image.replace('/','_').replace(':', '_'))
	cmd = "rm -f /tmp/{}; docker save -o /tmp/{} {}".format(tarFileName, tarFileName, args.image)
	runCommand(cmd)

	def deployToOneHost(host, image, tarFileName):
		log("{}: deploying image {}".format(host, image))

		log("copying image")
		cmd = "rsync --progress /tmp/{file} {host}:~/{file}".format(file=tarFileName, host=host)
		runCommand(cmd)

		log("{}: moving files and loading image into docker".format(host))
		cmd = "sudo mv ~/{tarFileName} /opt/scaleSim/{tarFileName} ; "
		cmd += "sudo docker load -i /opt/scaleSim/{tarFileName} ; "
		#cmd += "echo {image} | sudo tee /opt/scaleSim/latest-image"
		cmd = cmd.format(tarFileName=tarFileName, image=image)
		runCommandOnHost(cmd, host)
		log("{}: ScaleSim deployed to {}".format(host, image))

	doParallel(args.hosts, deployToOneHost, args.image, tarFileName)


def install(args):
	if args.build:
		runCommand('/opt/scaleSim/docker_build.sh')

	if args.deploy:
		deploy(args)

	def installOnHost(host):
		log("{}: installing ScaleSim".format(host))

		if host != 'localhost':
			log("{}: copying scaleSim files".format(host))
			cmd = "rsync ~/projects/nvmesh/management_cm/scaleSimulators/orch_manager/* {host}:~/scaleSim/".format(host=host)
			runCommand(cmd)

			log("{}: moving files to /opt/scaleSim/".format(host))
			cmd = "sudo mkdir -p /opt/scaleSim/ ; sudo mv ~/scaleSim/* /opt/scaleSim/"
			runCommandOnHost(cmd, host)
		else:
			cmd = "sudo mkdir -p /opt/scaleSim/ ; sudo cp ~/projects/nvmesh/management_cm/scaleSimulators/orch_manager/* /opt/scaleSim/"
			runCommand(cmd)

		# install dependencies only on remote hosts
		if host != 'localhost':
			log("{}: installing docker".format(host))
			cmd = "sudo /opt/scaleSim/docker_install.sh"
			runCommandOnHost(cmd, host)

			log('{}: install pymongo'.format(host))
			cmd = 'sudo pip install pymongo'
			runCommandOnHost(cmd, host)

		log("{}: creating scale-sim command in /usr/local/bin/scale-sim".format(host))
		cmd = "sudo ln -sf /opt/scaleSim/scale-sim-cli /usr/local/bin/scale-sim"
		runCommandOnHost(cmd, host)

		log("{}: scale-sim installed ".format(host))

	doParallel(args.hosts, installOnHost)


def clearSimulatorCache(args):
	cmd = 'sudo rm -rf {config_dir}/*'.format(config_dir=CONFIG_DIR)

	for host in args.hosts:
		runCommandOnHost(cmd, host)


def show_logs(args):
	follow_flag = '-f' if args.follow else ''
	cmd = 'docker logs {follow} {container_name}'.format(follow=follow_flag, container_name=args.container)
	res = runCommandOnHost(cmd, args.host)


def runCommand(cmd, debug=False):
	if debug:
		print(cmd)
	exitCode = subprocess.call(cmd, shell=True)
	return exitCode == 0


def runSshCommand(cmd, host, debug=False):
	sshCmd = "ssh {host} \"{cmd}\"".format(host=host, cmd=cmd)
	return runCommand(sshCmd, debug)


def runCommandOnHost(cmd, host, debug=False):
	if host == 'localhost':
		return runCommand(cmd, debug)
	else:
		return runSshCommand(cmd, host, debug)


if __name__ == "__main__":
	parser, subparsers = buildParser()
	ScaleSimControllerParser.addSubParsers(subparsers)
	args = parser.parse_args()

	if args.command == "run":
		run(args)
	elif args.command == "stop":
		stop(args)
	elif args.command == "deploy":
		deploy(args)
	elif args.command == "install":
		install(args)
	elif args.command == "logs":
		show_logs(args)
	elif args.command == "client":
		ClientController.handleCliCommand(args)
	elif args.command == "target":
		TargetController.handleCliCommand(args)
	elif args.command == "upgradeAgent":
		UpgradeAgentController.handleCliCommand(args)
	elif args.command == "component":
		NodeController.handleCliCommand(args)
	elif args.command == "clear" and args.clearWhat == "cache":
		clearSimulatorCache(args)
	else:
		log("command {} is not implemented".format(args.command))
