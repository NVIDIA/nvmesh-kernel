# Use Ubuntu 24.04 (Noble Numbat) as the base image
FROM ubuntu:24.04

ENV DIRPATH /excelero
WORKDIR $DIRPATH

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Fix segfault on libc-bin
RUN rm /var/lib/dpkg/info/libc-bin.*
RUN apt-get clean
RUN apt-get update
RUN apt-get install libc-bin

# Update apt package list and install build essentials and other useful tools
RUN apt update && apt install -y \
    build-essential \
    git \
    curl \
    wget \
    vim \
    rsync

RUN apt install -y \
    rdma-core \
    librdmacm1 \
    librdmacm-dev \
    rdmacm-utils

RUN apt install -y \
     libelf1 \
     elfutils \
     libudev1 \
     libudev-dev \
     alien

RUN apt install -y \
	linux-image-unsigned-6.8.0-71-generic \
	linux-headers-6.8.0-71-generic

RUN apt install -y \
    librdkafka1 \
    librdkafka-dev

# Add python3.10 for poetry compilation
# Use deadsnakes PPA to get python3.10
RUN apt install -y ca-certificates curl gnupg
RUN mkdir -p /etc/apt/keyrings

RUN curl -fsSL https://keyserver.ubuntu.com/pks/lookup?op=get\&search=0x6A755776 \
  | gpg --dearmor \
  | tee /etc/apt/keyrings/deadsnakes.gpg > /dev/null

RUN echo "deb [signed-by=/etc/apt/keyrings/deadsnakes.gpg] \
https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu noble main" \
> /etc/apt/sources.list.d/deadsnakes.list

RUN apt update
RUN apt install -y \
  python3.10 \
  python3.10-venv \
  python3.10-distutils \
  python3.10-dev

# Install Poetry with pip (no install.python-poetry.org). ensurepip bootstraps pip for python3.10; --user -> /root/.local/bin to persist into all subsequent RUN layers.
ENV PATH="${PATH}:/root/.local/bin"
RUN python3.10 -m ensurepip --upgrade --default-pip && \
    python3.10 -m pip install --user --no-cache-dir "poetry==2.3.1"
# Note: pyproject.toml and poetry.lock must be copied into the build context
# by build_docker.sh before building this Dockerfile.
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --only pet
# Set the default command for the container
#CMD ["/bin/bash"]

